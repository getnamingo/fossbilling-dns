{% set config = product.config|default({}) %}
{{ product_details }}

<div class="mb-3">
  <label class="form-label" for="domain_name">{{ 'Domain name'|trans }}</label>
  <input
    class="form-control"
    type="text"
    id="domain_name"
    name="domain_name"
    placeholder="example.com"
    required
    autocomplete="off"
    autocapitalize="off"
  >
  <div class="form-hint">
    {{ 'Enter the domain you want to manage DNS for. Example: example.com'|trans }}
  </div>
</div>

{% set nameservers = guest.servicedns_nameservers({product_id: product.id}) %}
{% if nameservers %}
<div class="card text-white bg-info mb-3">
  <div class="card-header"><h5 class="card-title">{{ 'Nameserver Setup'|trans }}</h5></div>
  <div class="card-body">
    <p class="card-text">{{ 'Set these nameservers at your domain registrar:'|trans }}</p>
    <ul>
      {% for nameserver in nameservers %}
        <li>{{ nameserver }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %}

<input type="hidden" name="id" value="{{ product.id }}"/>
<input type="hidden" name="action" value="register" id="dns-action"/>